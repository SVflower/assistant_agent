[importlinter]
root_package = assistant_agent

[importlinter:contract:contracts-have-no-project-dependencies]
name = Public contracts have no project dependencies
type = forbidden
source_modules =
    assistant_agent.contracts
forbidden_modules =
    assistant_agent.agent
    assistant_agent.cli
    assistant_agent.config
    assistant_agent.interaction
    assistant_agent.llm
    assistant_agent.mcp
    assistant_agent.obs
    assistant_agent.runtime
    assistant_agent.service
    assistant_agent.session
    assistant_agent.skills
    assistant_agent.tools
    assistant_agent.ui
    assistant_agent.web
    assistant_agent.main

[importlinter:contract:agent-does-not-depend-on-provider-adapters]
name = Agent does not depend on infrastructure or provider adapters
type = forbidden
source_modules =
    assistant_agent.agent
forbidden_modules =
    assistant_agent.providers.litellm
    assistant_agent.llm
    assistant_agent.runtime
    assistant_agent.obs.logger
    assistant_agent.session
    assistant_agent.service
    assistant_agent.ui
    assistant_agent.cli

[importlinter:contract:run-state-is-independent]
name = Run state is independent from sibling behavior
type = forbidden
source_modules =
    assistant_agent.agent.run.state
forbidden_modules =
    assistant_agent.agent.run.budgets
    assistant_agent.agent.run.checkpoint
    assistant_agent.agent.run.control
    assistant_agent.agent.run.coordinator
    assistant_agent.agent.run.recovery
    assistant_agent.agent.run.resume

[importlinter:contract:run-checkpoint-only-depends-on-state]
name = Run checkpoint does not depend on state transition modules
type = forbidden
source_modules =
    assistant_agent.agent.run.checkpoint
forbidden_modules =
    assistant_agent.agent.run.budgets
    assistant_agent.agent.run.control
    assistant_agent.agent.run.coordinator
    assistant_agent.agent.run.recovery
    assistant_agent.agent.run.resume

[importlinter:contract:run-budget-and-recovery-do-not-depend-on-coordinator]
name = Run budget and recovery policies do not depend on coordinator
type = forbidden
source_modules =
    assistant_agent.agent.run.budgets
    assistant_agent.agent.run.recovery
forbidden_modules =
    assistant_agent.agent.run.control
    assistant_agent.agent.run.coordinator
    assistant_agent.agent.run.resume

[importlinter:contract:tool-core-does-not-depend-on-concrete-adapters]
name = Tool ports and context do not depend on concrete adapters
type = forbidden
source_modules =
    assistant_agent.tools.context
    assistant_agent.tools.ports
forbidden_modules =
    assistant_agent.obs.logger
    assistant_agent.runtime
    assistant_agent.tools.artifacts

[importlinter:contract:application-does-not-depend-on-adapters]
name = Application does not depend on concrete adapters
type = forbidden
source_modules =
    assistant_agent.application
forbidden_modules =
    assistant_agent.bootstrap
    assistant_agent.integrations
    assistant_agent.execution
    assistant_agent.persistence
    assistant_agent.observability
    assistant_agent.mcp
    assistant_agent.skills
    assistant_agent.web
    assistant_agent.runtime
    assistant_agent.session
    assistant_agent.obs
    assistant_agent.service
    assistant_agent.cli
    assistant_agent.ui

[importlinter:contract:service-is-only-a-public-facade]
name = Service only depends on public contracts application and bootstrap
type = forbidden
allow_indirect_imports = True
source_modules =
    assistant_agent.service
forbidden_modules =
    assistant_agent.agent
    assistant_agent.cli
    assistant_agent.config
    assistant_agent.execution
    assistant_agent.integrations
    assistant_agent.interaction
    assistant_agent.llm
    assistant_agent.mcp
    assistant_agent.obs
    assistant_agent.observability
    assistant_agent.persistence
    assistant_agent.providers
    assistant_agent.runtime
    assistant_agent.session
    assistant_agent.skills
    assistant_agent.tools
    assistant_agent.ui
    assistant_agent.web
